package components

import "github.com/ruskiiamov/school/internal/view"

templ FieldError(message string) {
	if message != "" {
		<span class="basis-full text-sm text-rose-600">{ message }</span>
	}
}

templ FieldErrorSlot(id, message string, oob bool) {
	<span
		id={ id }
		data-error
		if oob {
			hx-swap-oob="true"
		}
		class="text-sm text-rose-600"
	>{ message }</span>
}

templ InactiveBadge() {
	<span class="shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-500">удалён</span>
}

templ InactiveToggle(href string, showInactive bool) {
	if showInactive {
		<a href={ templ.SafeURL(href) } class="text-sm font-medium text-indigo-700 hover:underline">Скрыть удалённые</a>
	} else {
		<a href={ templ.SafeURL(href) } class="text-sm font-medium text-indigo-700 hover:underline">Показать удалённые</a>
	}
}

templ EditLink(href, target string) {
	<a href={ templ.SafeURL(href) } hx-get={ href } hx-target={ target } hx-swap="outerHTML" class={ ButtonSecondaryClass }>Изменить</a>
}

templ ActiveForm(active bool, deactivateAction, activateAction, target string) {
	if active {
		<form
			method="post"
			action={ templ.SafeURL(deactivateAction) }
			if target != "" {
				hx-post={ deactivateAction }
				hx-target={ target }
				hx-swap="outerHTML"
			}
		>
			<button type="submit" class={ ButtonDangerClass }>Удалить</button>
		</form>
	} else {
		<form
			method="post"
			action={ templ.SafeURL(activateAction) }
			if target != "" {
				hx-post={ activateAction }
				hx-target={ target }
				hx-swap="outerHTML"
			}
		>
			<button type="submit" class={ ButtonSecondaryClass }>Восстановить</button>
		</form>
	}
}

templ EditForm(action, cancelHref, name, label, message, target string) {
	<form
		method="post"
		action={ templ.SafeURL(action) }
		hx-post={ action }
		hx-target={ target }
		hx-swap="outerHTML"
		class="flex flex-1 flex-wrap items-center gap-2"
	>
		<input
			type="text"
			name="name"
			value={ name }
			aria-label={ label }
			maxlength="100"
			autocomplete="off"
			autofocus
			class={ InputClassFor(message), "flex-1 basis-40" }
		/>
		<span class="ml-auto flex flex-wrap items-center gap-2">
			<button type="submit" class={ ButtonPrimaryClass }>Сохранить</button>
			<a href={ templ.SafeURL(cancelHref) } hx-get={ cancelHref } hx-target={ target } hx-swap="outerHTML" class={ ButtonSecondaryClass }>Отмена</a>
		</span>
		@FieldError(message)
	</form>
}

templ CreateForm(action, placeholder, label, name, message, target string) {
	<form
		method="post"
		action={ templ.SafeURL(action) }
		hx-post={ action }
		hx-target={ target }
		hx-swap="outerHTML"
		class={ CardClass, "flex flex-wrap items-center gap-2 p-3 sm:p-4" }
	>
		<input
			type="text"
			name="name"
			value={ name }
			placeholder={ placeholder }
			aria-label={ label }
			maxlength="100"
			autocomplete="off"
			class={ InputClassFor(message), "flex-1 basis-56" }
		/>
		<button type="submit" class={ ButtonPrimaryClass }>
			@Icon(view.IconPlus, "size-4")
			<span>Добавить</span>
		</button>
		@FieldError(message)
	</form>
}

templ RowInput(name, value, placeholder, label, message, class string) {
	<span class={ "flex min-w-0 flex-col gap-1", class }>
		<input
			type="text"
			name={ name }
			value={ value }
			placeholder={ placeholder }
			aria-label={ label }
			maxlength="100"
			autocomplete="off"
			class={ InputClassFor(message) }
		/>
		@FieldError(message)
	</span>
}

templ RowSelect(name, label string, options []view.Option, message, class string) {
	<span class={ "flex min-w-0 flex-col gap-1", class }>
		<select name={ name } aria-label={ label } class={ SelectClassFor(message) }>
			for _, option := range options {
				<option value={ optionValue(option) } selected?={ option.Selected }>{ option.Name }</option>
			}
		</select>
		@FieldError(message)
	</span>
}

templ RowDate(name, value, label, message, class string) {
	<span class={ "flex min-w-0 flex-col gap-1", class }>
		<input
			type="date"
			name={ name }
			value={ value }
			aria-label={ label }
			class={ InputClassFor(message) }
		/>
		@FieldError(message)
	</span>
}
