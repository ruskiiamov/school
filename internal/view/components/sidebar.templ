package components

import "github.com/ruskiiamov/school/internal/view"

templ Sidebar(items []view.NavItem) {
	<div
		id="nav-overlay"
		data-state="closed"
		class="fixed inset-0 z-30 bg-slate-900/50 opacity-0 transition-opacity duration-200 data-[state=closed]:pointer-events-none data-[state=open]:opacity-100 lg:hidden"
	></div>
	<aside
		id="sidebar"
		data-state="closed"
		class="fixed inset-y-0 left-0 z-40 flex w-[17rem] -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 data-[state=open]:translate-x-0 lg:sticky lg:top-0 lg:h-dvh lg:w-64 lg:translate-x-0 lg:shrink-0"
	>
		<div class="flex h-14 shrink-0 items-center gap-2.5 border-b border-slate-200 px-4 lg:h-16">
			<span class="flex size-8 items-center justify-center rounded-lg bg-indigo-600 text-white">
				@Icon(view.IconBook, "size-5")
			</span>
			<span class="text-sm font-semibold text-slate-900">Электронный журнал</span>
		</div>
		<nav class="flex flex-1 flex-col gap-0.5 overflow-y-auto p-3" aria-label="Разделы">
			for _, item := range items {
				@navLink(item)
			}
		</nav>
	</aside>
}

templ navLink(item view.NavItem) {
	<a
		href={ templ.SafeURL(item.Href) }
		if item.Active {
			aria-current="page"
			class="flex min-h-11 items-center gap-3 rounded-lg bg-indigo-50 px-3 text-sm font-medium text-indigo-700"
		} else {
			class="flex min-h-11 items-center gap-3 rounded-lg px-3 text-sm text-slate-700 hover:bg-slate-100 active:bg-slate-200"
		}
	>
		@Icon(item.Icon, "size-5 shrink-0")
		<span class="truncate">{ item.Title }</span>
	</a>
}
