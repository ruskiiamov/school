package components

templ PageHint(text string) {
	<p class="-mt-2 text-sm text-slate-500 lg:-mt-3">{ text }</p>
}

templ PageHelp(summary string) {
	<details class="group rounded-lg bg-slate-100/70 px-4 py-3 text-sm text-slate-700">
		<summary class="cursor-pointer select-none font-medium text-slate-900">{ summary }</summary>
		<div class="mt-2 flex flex-col gap-2">
			{ children... }
		</div>
	</details>
}
