package components

import "github.com/ruskiiamov/school/internal/view"

templ Topbar(schoolName string, user view.User) {
	<header class="sticky top-0 z-20 border-b border-slate-200 bg-white/90 backdrop-blur">
		<div class="flex h-14 items-center gap-2 px-4 sm:gap-3 sm:px-6 lg:h-16 lg:px-8">
			<button
				type="button"
				id="nav-toggle"
				aria-controls="sidebar"
				aria-expanded="false"
				aria-label="Открыть меню"
				class="-ml-2 flex size-11 shrink-0 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 active:bg-slate-200 lg:hidden"
			>
				@Icon(view.IconMenu, "size-6")
			</button>
			<span class="truncate text-base font-semibold text-slate-900 lg:text-lg">{ schoolName }</span>
			<div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-3">
				<span
					class="flex size-9 shrink-0 items-center justify-center rounded-full bg-indigo-100 text-indigo-700"
					aria-hidden="true"
				>
					@Icon(view.IconUser, "size-5")
				</span>
				<span class="hidden flex-col leading-tight sm:flex">
					<span class="text-sm font-medium text-slate-900">{ user.FullName }</span>
					<span class="text-xs text-slate-500">{ user.Role }</span>
				</span>
				<button
					type="button"
					hx-post="/logout"
					class="flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100 active:bg-slate-200"
				>
					@Icon(view.IconLogout, "size-5 shrink-0")
					<span class="hidden sm:inline">Выйти</span>
					<span class="sr-only sm:hidden">Выйти</span>
				</button>
			</div>
		</div>
	</header>
}
