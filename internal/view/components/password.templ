package components

import "github.com/ruskiiamov/school/internal/view"

templ PasswordInput(name, value, label, autocomplete, message string) {
	<span class="relative flex">
		<input
			type="password"
			name={ name }
			value={ value }
			aria-label={ label }
			autocomplete={ autocomplete }
			class={ InputClassFor(message), "pr-12" }
		/>
		<button
			type="button"
			data-toggle-password
			aria-label="Показать пароль"
			aria-pressed="false"
			class="absolute inset-y-0 right-0 flex w-11 items-center justify-center rounded-r-lg text-slate-500 hover:text-slate-700"
		>
			<span data-eye>
				@Icon(view.IconEye, "size-5")
			</span>
			<span data-eye-off hidden>
				@Icon(view.IconEyeOff, "size-5")
			</span>
		</button>
	</span>
}
