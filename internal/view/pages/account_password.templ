package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

var passwordFields = []string{"current", "new", "repeat"}

templ AccountPassword(page view.PasswordPage) {
	@layout.App(page.Shell) {
		<div class="mx-auto flex w-full max-w-xl flex-col gap-4 lg:gap-6">
			@components.PageHeader("Смена пароля")
			<form
				method="post"
				action="/account/password"
				hx-post="/account/password"
				hx-target="#password-status"
				hx-swap="innerHTML"
				hx-disabled-elt="find button[type='submit']"
				class={ components.CardClass, "flex flex-col gap-4 p-4 sm:p-6" }
			>
				<div id="password-status">
					if page.Done {
						@components.Success("Пароль изменён. Остальные ваши сессии завершены.")
					}
				</div>
				@passwordField("current", page.Values["current"], "Текущий пароль", "current-password", page.Errors["current"])
				@passwordField("new", page.Values["new"], "Новый пароль", "new-password", page.Errors["new"])
				@passwordField("repeat", page.Values["repeat"], "Повторите новый пароль", "new-password", page.Errors["repeat"])
				<p class="text-sm text-slate-500">Не короче 8 символов. После смены придётся войти заново на других устройствах.</p>
				<div class="flex justify-end">
					<button type="submit" class={ components.ButtonPrimaryClass }>Сменить пароль</button>
				</div>
			</form>
		</div>
	}
}

templ PasswordErrors(page view.PasswordPage) {
	for _, name := range passwordFields {
		@components.FieldErrorSlot(passwordErrorID(name), page.Errors[name], true)
	}
}

templ passwordField(name, value, label, autocomplete, message string) {
	<label data-field class="flex flex-col gap-1.5">
		<span class="text-sm font-medium text-slate-700">{ label }</span>
		@components.PasswordInput(name, value, label, autocomplete, message)
		@components.FieldErrorSlot(passwordErrorID(name), message, false)
	</label>
}

func passwordErrorID(name string) string {
	return "error-" + name
}
