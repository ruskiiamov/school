package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const lessonCardFormID = "lesson-card-form"

templ LessonCard(card view.LessonCard) {
	@modalHeader(card.Title)
	@lessonCardBody(card, true)
}

templ LessonCardPage(page view.LessonCardPage) {
	@layout.App(page.Shell) {
		<div class="mx-auto flex w-full max-w-xl flex-col gap-4">
			@components.PageHeader(page.Card.Title) {
				<a href={ templ.SafeURL(page.Card.BackHref) } class="text-sm font-medium text-indigo-700 hover:underline">← К журналу</a>
			}
			<section class={ components.CardClass }>
				@lessonCardBody(page.Card, false)
			</section>
		</div>
	}
}

templ lessonCardBody(card view.LessonCard, modal bool) {
	<div class="flex flex-col">
		if card.Author != "" {
			<p class="px-4 pt-3 text-sm text-slate-500">{ card.Author }</p>
		}
		<form
			id={ lessonCardFormID }
			method="post"
			action={ templ.SafeURL(card.Action) }
			enctype="multipart/form-data"
			if modal {
				hx-post={ card.Action }
				hx-encoding="multipart/form-data"
				hx-target={ "#" + modalBodyID }
				hx-swap="innerHTML"
			}
			class="flex flex-col gap-3 p-4"
		>
			<span class="flex flex-col gap-1 sm:hidden">
				<label for="card-topic" class="text-sm font-semibold text-slate-900">Тема</label>
				<input id="card-topic" name="topic" value={ card.Topic } placeholder="Тема не задана" autocomplete="off" class={ components.InputCompactClassFor(card.Errors["topic"]), "w-full" }/>
				@components.FieldError(card.Errors["topic"])
			</span>
			<span class="flex flex-col gap-1">
				<label for="card-homework-text" class="text-sm font-semibold text-slate-900">Домашнее задание</label>
				<textarea
					id="card-homework-text"
					name="text"
					rows="4"
					maxlength="2000"
					if modal {
						autofocus
					}
					class={ components.InputClassFor(card.Errors["text"]), "py-2" }
				>{ card.Text }</textarea>
				@components.FieldError(card.Errors["text"])
			</span>
			<span class="flex flex-wrap items-center gap-2">
				<label for="card-homework-due" class="text-sm font-semibold text-slate-900">Срок</label>
				@components.DateInput("due", card.Due, "Срок", components.InputCompactClassFor(card.Errors["due"])+" w-36", templ.Attributes{"id": "card-homework-due"})
				@components.FieldError(card.Errors["due"])
			</span>
			if len(card.Files) > 0 {
				<ul class="flex flex-col divide-y divide-slate-100 rounded-lg ring-1 ring-slate-200">
					for _, file := range card.Files {
						<li class="group flex items-center gap-2 py-1 pr-3 pl-1">
							<label class="cursor-pointer">
								<input type="checkbox" name="remove" value={ file.ID } checked?={ file.Remove } class="peer sr-only"/>
								<span title="Удалить файл при сохранении" class="inline-flex size-9 items-center justify-center rounded-md text-slate-400 peer-checked:bg-rose-50 peer-checked:text-rose-700 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-400 hover:text-rose-700">
									@components.Icon(view.IconTrash, "size-4")
									<span class="sr-only">Удалить { file.Name }</span>
								</span>
							</label>
							<a href={ templ.SafeURL(file.Href) } class="min-w-0 flex-1 truncate text-sm font-medium text-indigo-700 group-has-checked:line-through group-has-checked:opacity-60 hover:underline">{ file.Name }</a>
							<span class="shrink-0 text-xs text-slate-500">{ file.Size }</span>
						</li>
					}
				</ul>
			}
			if card.CanUpload {
				<label class={ components.ButtonSecondaryClass, "cursor-pointer self-start" }>
					@components.Icon(view.IconPlus, "size-4")
					<span>Прикрепить файлы</span>
					<input type="file" name="files" multiple data-file-names class="sr-only"/>
				</label>
				<span data-file-list class="text-sm text-slate-700 empty:hidden"></span>
			}
			@components.FieldError(card.Errors["files"])
		</form>
		<div class="flex justify-center border-t border-slate-100 px-4 py-3">
			<button type="submit" form={ lessonCardFormID } class={ components.ButtonPrimaryClass }>Сохранить</button>
		</div>
	</div>
}
