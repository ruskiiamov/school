package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const workTypesTarget = "#work-types"

templ WorkTypes(page view.WorkTypesPage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-4 lg:gap-6">
			@components.PageHeader("Типы работ") {
				if page.Base != "" {
					@components.InactiveToggle(inactiveToggleURL(page.Base, page.ShowInactive), page.ShowInactive)
				}
			}
			@components.PageHint("Как устроены типы работ", hintWorkTypes)
			if len(page.Subjects) == 0 {
				<div class={ components.CardClass }>
					@components.EmptyState("Вам пока не назначены предметы")
				</div>
			} else {
				<nav aria-label="Предмет" class="flex flex-wrap gap-1">
					for _, subject := range page.Subjects {
						@tabLink(subject.Name, subject.Href, subject.Active)
					}
				</nav>
				@WorkTypesList(page)
			}
		</div>
	}
}

templ WorkTypesList(page view.WorkTypesPage) {
	<div id="work-types" class="flex flex-col gap-4 lg:gap-6">
		@components.CreateForm(catalogURL(page.Base, 0, "", page.ShowInactive),
			"Новый тип работы", "Название нового типа работы", page.NewName, page.NewError, workTypesTarget) {
			if page.Penalties {
				@penalizedCheckbox(page.NewPenalized)
			}
		}
		<div class={ components.CardClass, "overflow-hidden" }>
			if len(page.WorkTypes) == 0 {
				@components.EmptyState("Пока нет типов работ. Добавьте те, за которые ставите оценки")
			} else {
				<ul class="divide-y divide-slate-100">
					for _, workType := range page.WorkTypes {
						@workTypeRow(page.Base, workType, page.ShowInactive, page.Penalties)
					}
				</ul>
			}
		</div>
	</div>
}

templ workTypeRow(base string, row view.WorkTypeRow, showInactive, penalties bool) {
	<li class={ "flex flex-wrap items-center gap-2", templ.KV("p-3 sm:p-4", row.Editing) }>
		if row.Active && !row.Editing {
			<form method="post" action={ templ.SafeURL(catalogURL(base, row.ID, "/up", showInactive)) } class="flex shrink-0 items-center pl-3 sm:pl-4">
				@moveButton(catalogURL(base, row.ID, "/up", showInactive), view.IconUp, "Выше", row.CanUp)
				@moveButton(catalogURL(base, row.ID, "/down", showInactive), view.IconDown, "Ниже", row.CanDown)
			</form>
		}
		if row.Editing && penalties {
			@workTypeEditForm(base, row, showInactive)
		} else if row.Editing {
			@components.EditForm(catalogURL(base, row.ID, "", showInactive),
				catalogURL(base, 0, "", showInactive), row.Name, "Название типа работы", row.Error, workTypesTarget) {
				@components.ActiveButton(row.Active,
					catalogURL(base, row.ID, "/deactivate", showInactive),
					catalogURL(base, row.ID, "/activate", showInactive))
			}
		} else {
			@components.RowLink(catalogEditURL(base, row.ID, showInactive), workTypesTarget) {
				if row.Active {
					<span class="min-w-0 flex-1 truncate text-sm font-medium text-slate-900">{ row.Name }</span>
					if penalties && row.Penalized {
						<span class="shrink-0 rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600">со штрафом</span>
					}
				} else {
					<span class="min-w-0 flex-1 truncate text-sm text-slate-500">{ row.Name }</span>
					@components.InactiveBadge()
				}
			}
		}
	</li>
}

templ moveButton(action string, icon view.Icon, label string, enabled bool) {
	<button
		type="submit"
		formaction={ action }
		hx-post={ action }
		hx-target={ workTypesTarget }
		hx-swap="outerHTML"
		aria-label={ label }
		title={ label }
		if !enabled {
			disabled
		}
		class={ components.ButtonIconClass }
	>
		@components.Icon(icon, "size-5")
	</button>
}

templ workTypeEditForm(base string, row view.WorkTypeRow, showInactive bool) {
	<form
		method="post"
		action={ templ.SafeURL(catalogURL(base, row.ID, "", showInactive)) }
		hx-post={ catalogURL(base, row.ID, "", showInactive) }
		hx-target={ workTypesTarget }
		hx-swap="outerHTML"
		data-edit-form
		data-cancel={ catalogURL(base, 0, "", showInactive) }
		class="flex flex-1 flex-wrap items-center gap-2"
	>
		<input
			type="text"
			name="name"
			value={ row.Name }
			aria-label="Название типа работы"
			maxlength="100"
			autocomplete="off"
			autofocus
			class={ components.InputClassFor(row.Error), "min-w-0 flex-1 basis-40" }
		/>
		<span class="ml-auto flex shrink-0 items-center gap-2">
			@penalizedCheckbox(row.Penalized)
			@components.SaveButton()
			@components.ActiveButton(row.Active,
				catalogURL(base, row.ID, "/deactivate", showInactive),
				catalogURL(base, row.ID, "/activate", showInactive))
		</span>
		@components.FieldError(row.Error)
	</form>
}

templ penalizedCheckbox(checked bool) {
	<label class={ checkboxLabelClass, "shrink-0 px-1 text-slate-700" }>
		<input type="checkbox" name="penalized" value="1" checked?={ checked } class={ checkboxClass }/>
		Со штрафом
	</label>
}
