package pages

import (
	"strconv"

	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const (
	journalContentID = "journal-content"
	modalBodyID      = "modal-body"
)

templ PairJournal(page view.PairJournalPage) {
	@layout.App(page.Shell) {
		<div class="flex h-[calc(100dvh-6.5rem-1px)] flex-col gap-4 lg:h-[calc(100dvh-8rem-1px)] lg:gap-6">
			@components.PageHeader(page.Title) {
				<a href={ templ.SafeURL(page.BackHref) } class="text-sm font-medium text-indigo-700 hover:underline">← Главная</a>
			}
			@components.PageHelp("Как работать с журналом") {
				<p>В ячейке — оценки за урок по порядку типов работ, «Н» — ученик не был на уроке, точка — есть комментарий</p>
				<p>Перед первой оценкой заведите типы работ: в разделе «Типы работ» или в строке «Новый тип работы» под раскрытым уроком</p>
				<p>Оценку и комментарий одному ученику — нажмите на ячейку</p>
				<p>Чтобы поставить оценки всему классу, нажмите стрелку у урока: под ним откроются строки типов работ</p>
				<p>Новый урок — введите его дату в первой строке таблицы</p>
				<p>Чтобы удалить урок без оценок и записей, сотрите его дату</p>
			}
			@PairJournalContent(page.Content, false)
		</div>
		@journalModal()
	}
}

templ journalModal() {
	<dialog
		id="journal-modal"
		aria-labelledby="journal-modal-title"
		class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-xl overflow-y-auto rounded-xl bg-white p-0 shadow-lg ring-1 ring-slate-200 backdrop:bg-slate-900/50"
	>
		<div id={ modalBodyID }></div>
	</dialog>
}

templ modalHeader(title string) {
	<div class="sticky top-0 z-10 flex items-center justify-between gap-3 border-b border-slate-100 bg-white px-4 py-3">
		<h2 id="journal-modal-title" class="text-base font-semibold text-slate-900">{ title }</h2>
		<button type="button" data-modal-close aria-label="Закрыть" title="Закрыть" class={ components.ButtonIconClass }>
			@components.Icon(view.IconClose, "size-5")
		</button>
	</div>
}

templ PairJournalContent(content view.PairJournalContent, oob bool) {
	<div
		id="journal-content"
		if oob {
			hx-swap-oob="true"
		}
		class="flex min-h-0 flex-1 flex-col gap-4 lg:gap-6"
	>
		if content.Periods != "" {
			<p class="text-sm text-slate-700">{ content.Periods }</p>
		}
		<section class={ components.CardClass, "flex min-h-0 flex-col" }>
			@journalTable(content)
		</section>
	</div>
}

templ journalTable(content view.PairJournalContent) {
	<div class="journal-scroll min-h-0 flex-1 scroll-pt-[var(--journal-head,15rem)] scroll-pl-[var(--journal-side,0px)] overflow-auto rounded-xl">
		<table class="journal-table w-full border-separate border-spacing-0 text-sm">
			<thead>
				<tr>
					<td class="sticky top-0 left-0 z-30 w-px border-b border-slate-200 bg-white px-5 align-middle text-sm font-semibold whitespace-nowrap text-slate-900">Всего: { content.Lessons }</td>
					for _, student := range content.Table.Students {
						@journalStudentHead(student, false)
					}
					if len(content.Table.Students) == 0 {
						<th scope="col" class="sticky top-0 z-20 border-b border-slate-200 bg-white px-3 py-2 text-left font-normal text-slate-500">В классе пока нет учеников</th>
					}
				</tr>
			</thead>
			<tbody hx-boost="true" hx-target={ "#" + modalBodyID } hx-swap="innerHTML">
				if content.New != nil {
					@newLessonRow(*content.New, max(len(content.Table.Students), 1))
				}
				for _, row := range content.Table.Rows {
					@journalRow(row)
				}
				if len(content.Table.Rows) == 0 {
					<tr>
						<td colspan={ strconv.Itoa(columns(content.Table)) }>
							@components.EmptyState("Уроков пока нет")
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

func columns(table view.JournalTable) int {
	return max(len(table.Students), 1) + 1
}

templ newLessonRow(form view.NewLessonForm, cells int) {
	<tr>
		<th scope="row" class="sticky left-0 z-10 w-px border-b border-slate-100 bg-white px-3 py-1 text-left font-normal whitespace-nowrap">
			<form
				method="post"
				action={ templ.SafeURL(form.Action) }
				hx-post={ form.Action }
				hx-target={ "#" + journalContentID }
				hx-swap="outerHTML"
				hx-trigger="submit, change"
				hx-sync="this:drop"
				class="flex items-center gap-2"
			>
				@components.DateInput("date", form.Date, "Дата нового урока", components.InputCompactClassFor(form.Error)+" w-[8.25rem] font-medium", templ.Attributes{"id": "new-lesson-date", "title": "Новый урок"})
				@components.NoScriptSubmit("Добавить")
			</form>
			if form.Error != "" {
				<span class="block max-w-xs text-xs whitespace-normal text-rose-600">{ form.Error }</span>
			}
		</th>
		<td colspan={ strconv.Itoa(cells) }></td>
	</tr>
}

templ journalStudentHead(student view.JournalStudentHead, oob bool) {
	<th
		id={ student.ID }
		if oob {
			hx-swap-oob="true"
		}
		scope="col"
		title={ studentTitle(student) }
		class="sticky top-0 z-20 border-b border-l border-slate-200 bg-white px-1 py-2 align-bottom"
	>
		<span class="flex flex-col items-center gap-1">
			<span
				class={ "mx-auto flex min-w-16 flex-col text-xs leading-tight font-medium whitespace-nowrap sm:min-w-[4.5rem] sm:text-sm",
					templ.KV("text-slate-900", student.Active && student.InClass),
					templ.KV("text-slate-400", !student.Active),
					templ.KV("text-amber-700", student.Active && !student.InClass) }
			>
				<span>{ student.LastName }</span>
				<span>{ student.FirstName }</span>
			</span>
			<span class="mt-1 flex w-full flex-col items-center gap-0.5 border-t border-slate-200 pt-1.5">
				<span title="Средний балл за учебный год" class="text-xs font-semibold text-slate-900 tabular-nums">{ student.Average }</span>
				<span title="Пропуски за учебный год" class="text-xs text-slate-500 tabular-nums">{ student.Absences }</span>
			</span>
		</span>
	</th>
}

func marksToggleHref(row view.JournalRow) string {
	if row.Expanded && row.CollapseHref != "" {
		return row.CollapseHref
	}

	return row.MarksHref
}

func studentTitle(student view.JournalStudentHead) string {
	title := student.FullName
	if !student.Active {
		title += " (удалён)"
	}

	if !student.InClass {
		title += " (не в классе)"
	}

	return title
}

templ journalRow(row view.JournalRow) {
	@journalLessonRow(row, false)
	if row.Marks != nil {
		@lessonMarksRows(*row.Marks, true)
	}
}

templ JournalRowGroup(row view.JournalRow) {
	@journalRow(row)
}

templ journalLessonRow(row view.JournalRow, oob bool) {
	<tr
		id={ row.Anchor }
		if oob {
			hx-swap-oob="true"
		}
		data-highlight?={ row.Highlight }
	>
		<th scope="row" class="sticky left-0 z-10 w-px border-b border-slate-100 bg-white px-3 py-1 text-left font-normal whitespace-nowrap">
			<span class="flex items-center gap-1">
				if row.Edit != nil {
					<form
						method="post"
						action={ templ.SafeURL(row.Edit.DateAction) }
						hx-post={ row.Edit.DateAction }
						hx-target={ "#" + journalContentID }
						hx-swap="outerHTML"
						hx-trigger="submit, change"
						hx-sync="this:drop"
						data-confirm-empty={ "Удалить урок " + row.Date + "?" }
						class="quiet-date"
					>
						@components.DateInput("date", row.Edit.DateValue, "Дата урока", components.InputQuietClassFor(row.Edit.DateError)+" w-[8.25rem] font-medium", nil)
					</form>
					@JournalTopic(*row.Edit, row.Topic)
				} else {
					<span class="px-2 font-medium text-slate-900 tabular-nums">{ row.Date }</span>
					<span class="ml-2 hidden w-54 truncate text-slate-700 sm:block" title={ row.Topic }>{ row.Topic }</span>
				}
				<span class="ml-2">
					if row.CardHref != "" {
						@homeworkBadge(row.CardHref, row.Homework)
					} else {
						@homeworkLabel(row.Homework)
					}
				</span>
				if row.MarksHref != "" {
					@marksToggle(row)
				}
				if row.Author != "" {
					<span title={ "Урок провёл " + row.Author } class="ml-1 text-slate-400">
						@components.Icon(view.IconSwap, "size-4")
						<span class="sr-only">Урок провёл { row.Author }</span>
					</span>
				}
			</span>
			if row.Edit != nil && row.Edit.DateError != "" {
				<span class="block max-w-xs text-xs whitespace-normal text-rose-600">{ row.Edit.DateError }</span>
			}
		</th>
		for _, cell := range row.Cells {
			<td>
				<a
					href={ templ.SafeURL(cell.Href) }
					if cell.Title != "" {
						title={ cell.Title }
					}
				>
					{ cell.Text }
					if cell.Comment {
						<span>•</span>
					}
				</a>
			</td>
		}
	</tr>
}

templ JournalTopic(edit view.JournalRowEdit, topic string) {
	<form
		id={ edit.TopicID }
		data-field
		method="post"
		action={ templ.SafeURL(edit.TopicAction) }
		hx-post={ edit.TopicAction }
		hx-target={ "#" + edit.TopicID + "-error" }
		hx-swap="outerHTML"
		hx-trigger="submit, input changed delay:500ms"
		class="hidden sm:block"
	>
		<input
			name="topic"
			value={ topic }
			placeholder="Тема"
			aria-label="Тема урока"
			title={ topic }
			class={ components.InputQuietClass, "w-54 truncate" }
		/>
		@TopicError(edit.TopicID+"-error", edit.TopicError)
	</form>
}

templ TopicError(id, message string) {
	<span id={ id } data-error class="block max-w-xs text-xs whitespace-normal text-rose-600 empty:hidden">{ message }</span>
}

templ homeworkBadge(href string, set bool) {
	<a
		href={ templ.SafeURL(href) }
		title="Домашнее задание"
		if set {
			class="inline-flex shrink-0 rounded-md bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-300 hover:bg-emerald-100"
		} else {
			class="inline-flex shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-500 ring-1 ring-slate-200 hover:bg-slate-200"
		}
	>ДЗ</a>
}

templ homeworkLabel(set bool) {
	<span
		if set {
			class="inline-flex shrink-0 rounded-md bg-emerald-50 px-1.5 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-emerald-300"
		} else {
			class="inline-flex shrink-0 rounded-md bg-slate-100 px-1.5 py-0.5 text-xs font-medium text-slate-500 ring-1 ring-slate-200"
		}
	>ДЗ</span>
}

templ marksToggle(row view.JournalRow) {
	<a
		href={ templ.SafeURL(marksToggleHref(row)) }
		hx-get={ row.MarksHref }
		hx-target={ "#" + row.Anchor }
		hx-swap="outerHTML"
		data-marks-toggle
		aria-expanded={ strconv.FormatBool(row.Expanded) }
		aria-label="Оценки по типам работ"
		title="Оценки по типам работ"
		class="group ml-1 inline-flex size-7 shrink-0 items-center justify-center rounded-md text-slate-500 hover:bg-slate-100 hover:text-slate-900 aria-expanded:bg-indigo-50 aria-expanded:text-indigo-700"
	>
		@components.Icon(view.IconDown, "size-4 -rotate-90 transition-transform group-aria-expanded:rotate-0")
	</a>
}

templ lessonMarksRows(block view.LessonMarksBlock, live bool) {
	for _, row := range block.Rows {
		<tr data-marks-of={ block.Lesson }>
			<th scope="row" class="sticky left-0 z-10 w-px border-b border-slate-100 bg-slate-50 py-1 pr-3 pl-5 text-left text-sm font-normal whitespace-nowrap sm:pl-10">
				<span
					title={ row.Name }
					class={ "block max-w-28 truncate sm:max-w-54", templ.KV("text-slate-700", row.Active), templ.KV("text-slate-400", !row.Active) }
				>{ row.Name }</span>
			</th>
			for _, cell := range row.Cells {
				@lessonMarkCell(block.Action, cell, live, false)
			}
		</tr>
	}
	<tr data-marks-of={ block.Lesson }>
		<th scope="row" class="sticky left-0 z-10 w-px border-b border-slate-200 bg-slate-50 py-1 pr-3 pl-5 text-left font-normal whitespace-nowrap sm:pl-10">
			if len(block.Rows) == 0 && block.Empty != "" {
				<span class="block py-1 text-sm text-slate-500">{ block.Empty }</span>
			}
			if block.NewType != nil && live {
				@newWorkTypeForm(*block.NewType)
			}
			@marksError(block.ErrorID, block.Error, false)
		</th>
		<td colspan={ strconv.Itoa(block.Columns) } class="border-b border-slate-200 bg-slate-50"></td>
	</tr>
}

templ newWorkTypeForm(form view.NewWorkTypeForm) {
	<form
		method="post"
		action={ templ.SafeURL(form.Action) }
		hx-post={ form.Action }
		hx-target={ "#" + journalContentID }
		hx-swap="outerHTML"
		class="flex items-center gap-2"
	>
		<input
			name="name"
			value={ form.Name }
			placeholder="Новый тип работы"
			aria-label="Новый тип работы"
			autocomplete="off"
			class={ components.InputCompactClass, "peer w-32 sm:w-54" }
		/>
		@components.IconSubmit(view.IconPlus, "Добавить тип работы", components.ButtonIconCompactClass+" peer-placeholder-shown:hidden")
	</form>
}

templ marksError(id, message string, oob bool) {
	<span
		id={ id }
		if oob {
			hx-swap-oob="true"
		}
		class="block max-w-xs text-xs whitespace-normal text-rose-600 empty:hidden"
	>{ message }</span>
}

templ lessonMarkCell(action string, cell view.LessonMarkCell, live bool, oob bool) {
	<td
		id={ cell.ID }
		if oob {
			hx-swap-oob="true"
		}
		class="bg-slate-50"
	>
		if cell.Editable {
			<span class="flex items-center justify-center gap-0.5 px-1 py-1">
				<input
					name={ cell.Field }
					value={ cell.Value }
					inputmode="numeric"
					maxlength="2"
					autocomplete="off"
					aria-label={ cell.Label }
					if cell.Error != "" {
						title={ cell.Error }
						aria-invalid="true"
					} else if cell.Comment != "" {
						title={ cell.Comment }
					}
					if live {
						data-mark-cell
						hx-post={ action }
						hx-trigger="change"
						hx-target="closest td"
						hx-swap="outerHTML"
						hx-sync="closest tbody:queue all"
					}
					class={ components.InputCompactClassFor(cell.Error), "w-11 text-center font-semibold" }
				/>
				if cell.Comment != "" {
					<span title={ cell.Comment } class="text-indigo-500">•</span>
				}
			</span>
		} else if cell.Value != "" {
			<span
				if cell.Comment != "" {
					title={ cell.Comment }
				}
				class="flex items-center justify-center gap-0.5 px-1 py-1.5 font-semibold text-slate-900 tabular-nums"
			>
				{ cell.Value }
				if cell.Comment != "" {
					<span class="text-indigo-500">•</span>
				}
			</span>
		}
	</td>
}

templ LessonMarkCells(action string, cells []view.LessonMarkCell, row *view.JournalRow, students []view.JournalStudentHead, errorID, message string) {
	for _, cell := range cells {
		@lessonMarkCell(action, cell, true, false)
	}
	if row != nil {
		<template>
			@journalLessonRow(*row, true)
		</template>
	}
	for _, student := range students {
		<template>
			@journalStudentHead(student, true)
		</template>
	}
	@marksError(errorID, message, true)
}

templ LessonMarksPage(page view.LessonMarksPage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-4 lg:gap-6">
			@components.PageHeader(page.Title) {
				<a href={ templ.SafeURL(page.BackHref) } class="text-sm font-medium text-indigo-700 hover:underline">← К журналу</a>
			}
			if len(page.Errors) > 0 {
				<ul class="flex flex-col gap-1 rounded-lg bg-rose-50 px-4 py-3 text-sm text-rose-700">
					for _, message := range page.Errors {
						<li>{ message }</li>
					}
				</ul>
			}
			<form method="post" action={ templ.SafeURL(page.Block.Action) } class={ components.CardClass, "flex flex-col" }>
				<div class="overflow-x-auto">
					<table class="journal-table w-full border-separate border-spacing-0 text-sm">
						<thead>
							<tr>
								<td class="w-px border-b border-slate-200 bg-white px-3"></td>
								for _, student := range page.Students {
									<th scope="col" class="border-b border-l border-slate-200 bg-white px-1 py-2 text-xs font-medium whitespace-nowrap">
										<a href={ templ.SafeURL(student.Href) } class="text-indigo-700 hover:underline">{ student.Name }</a>
									</th>
								}
							</tr>
						</thead>
						<tbody>
							@lessonMarksRows(page.Block, false)
						</tbody>
					</table>
				</div>
				<div class="flex justify-center border-t border-slate-100 px-4 py-3">
					<button type="submit" class={ components.ButtonPrimaryClass }>Сохранить</button>
				</div>
			</form>
			if page.Block.NewType != nil {
				<section class={ components.CardClass, "p-4" }>
					<form method="post" action={ templ.SafeURL(page.Block.NewType.Action) } class="flex flex-wrap items-center gap-2">
						<input
							name="name"
							value={ page.Block.NewType.Name }
							placeholder="Новый тип работы"
							aria-label="Новый тип работы"
							autocomplete="off"
							class={ components.InputCompactClass, "w-64" }
						/>
						<button type="submit" class={ components.ButtonSecondaryClass }>Добавить</button>
					</form>
				</section>
			}
		</div>
	}
}

