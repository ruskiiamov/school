package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const (
	lessonTopicTarget   = "#lesson-topic"
	lessonTarget        = "#lesson"
	lessonActionsTarget = "#lesson-actions"
)

templ Lesson(page view.LessonPage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-4 lg:gap-6">
			@components.PageHeader(page.Title) {
				@LessonActions(page, false)
			}
			@LessonTopic(page)
			@LessonBlock(page.Block)
		</div>
	}
}

templ LessonActions(page view.LessonPage, oob bool) {
	<div
		id="lesson-actions"
		if oob {
			hx-swap-oob="true"
		}
		class="flex flex-wrap items-center gap-3"
	>
		if page.DeleteError != "" {
			<span class="text-sm text-rose-600">{ page.DeleteError }</span>
		}
		if page.CanDelete {
			<form
				method="post"
				action={ templ.SafeURL(page.Path + "/delete") }
				hx-post={ page.Path + "/delete" }
				hx-target={ lessonActionsTarget }
				hx-swap="outerHTML"
				hx-confirm={ "Удалить урок " + page.Title + "?" }
				data-confirm-ok="Удалить"
			>
				<button type="submit" class={ components.ButtonDangerClass }>Удалить урок</button>
			</form>
		}
	</div>
}

templ LessonBlockUpdate(page view.LessonPage) {
	@LessonBlock(page.Block)
	@LessonActions(page, true)
}

templ LessonTopic(page view.LessonPage) {
	<form
		id="lesson-topic"
		method="post"
		action={ templ.SafeURL(page.Path + "/topic") }
		hx-post={ page.Path + "/topic" }
		hx-target={ lessonTopicTarget }
		hx-swap="outerHTML"
		hx-trigger="submit, input changed delay:500ms"
		class={ components.CardClass, "flex flex-wrap items-start gap-2 p-3 sm:p-4" }
	>
		<label for="lesson-topic-input" class="flex min-h-11 basis-full items-center text-sm font-semibold text-slate-900 sm:basis-auto">Тема урока</label>
		<span class="flex min-w-0 flex-1 basis-56 flex-col gap-1">
			<input
				type="text"
				id="lesson-topic-input"
				hx-preserve
				name="topic"
				value={ page.Topic }
				placeholder="Тема не задана"
				maxlength="200"
				autocomplete="off"
				class={ components.InputClassFor(page.TopicError) }
			/>
			@components.FieldError(page.TopicError)
		</span>
		<button type="submit" class={ components.ButtonPrimaryClass, "shrink-0" }>Сохранить</button>
	</form>
}

templ LessonBlock(block view.LessonBlock) {
	<div id="lesson" class="grid items-start gap-4 lg:grid-cols-[18rem_minmax(0,1fr)] lg:gap-6">
		<nav aria-label="Ученики" class={ components.CardClass, "p-2 lg:p-0" }>
			if len(block.Students) == 0 {
				@components.EmptyState("В классе пока нет учеников")
			} else {
				<ul class="flex flex-wrap gap-2 lg:flex-col lg:gap-0 lg:divide-y lg:divide-slate-100">
					for _, student := range block.Students {
						@lessonStudentItem(student)
					}
				</ul>
			}
		</nav>
		if block.Selected != nil {
			@lessonStudentPanel(*block.Selected)
		}
	</div>
}

templ lessonStudentItem(student view.LessonStudentItem) {
	<li class="lg:flex">
		<a
			href={ templ.SafeURL(student.Href) }
			hx-get={ student.Href }
			hx-target={ lessonTarget }
			hx-swap="outerHTML"
			hx-push-url="true"
			if student.Selected {
				aria-current="true"
				class="flex min-h-11 items-center gap-2 rounded-lg bg-indigo-50 px-3 text-sm font-medium text-indigo-700 lg:w-full lg:rounded-none lg:px-4"
			} else {
				class="flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm text-slate-700 ring-1 ring-slate-200 hover:bg-slate-50 lg:w-full lg:rounded-none lg:ring-0 lg:px-4"
			}
		>
			<span class="truncate lg:hidden">{ student.ShortName }</span>
			<span class="hidden min-w-0 flex-1 truncate lg:inline">{ student.FullName }</span>
			if !student.Active {
				@components.InactiveBadge()
			}
			if !student.InClass {
				<span class="shrink-0 rounded-md bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700">не в классе</span>
			}
			if student.Summary != "" {
				<span class="shrink-0 text-xs font-semibold text-slate-500">{ student.Summary }</span>
			}
		</a>
	</li>
}

templ lessonStudentPanel(panel view.LessonStudentPanel) {
	<section class={ components.CardClass }>
		<div class="flex flex-wrap items-center gap-2 border-b border-slate-100 px-4 py-3 lg:px-5">
			<h2 class="text-sm font-semibold text-slate-900">{ panel.FullName }</h2>
			if !panel.Active {
				@components.InactiveBadge()
			}
			if !panel.InClass {
				<span class="shrink-0 rounded-md bg-amber-50 px-1.5 py-0.5 text-xs font-medium text-amber-700">не в классе</span>
			}
		</div>
		if len(panel.Marks) == 0 {
			@components.EmptyState("Оценок пока нет")
		} else {
			<ul class="divide-y divide-slate-100">
				for _, mark := range panel.Marks {
					@markRow(mark)
				}
			</ul>
		}
		if panel.InClass {
			<form
				method="post"
				action={ templ.SafeURL(panel.AddAction) }
				hx-post={ panel.AddAction }
				hx-target={ lessonTarget }
				hx-swap="outerHTML"
				class="flex flex-wrap items-start gap-2 border-t border-slate-100 p-3 sm:p-4"
			>
				@markFields(panel.New)
				<button type="submit" class={ components.ButtonPrimaryClass, "shrink-0" }>Поставить</button>
			</form>
			@recordForms(panel.Record)
		}
		if panel.Error != "" {
			<div class="flex border-t border-slate-100 px-4 py-3">
				@components.FieldError(panel.Error)
			</div>
		}
	</section>
}

templ markFields(fields view.MarkFields) {
	@components.RowSelect("work_type_id", "Тип работы", fields.WorkTypes, fields.Errors["work_type"], "flex-1 basis-52")
	@components.RowSelect("value", "Оценка", fields.Values, fields.Errors["value"], "w-28")
	@components.RowInput("label", fields.Label, "За что", "За что", fields.Errors["label"], "flex-1 basis-40")
}

templ markRow(mark view.MarkRow) {
	<li class="flex flex-wrap items-center gap-2 p-3 sm:p-4">
		if mark.Editing {
			<form
				method="post"
				action={ templ.SafeURL(mark.Action) }
				hx-post={ mark.Action }
				hx-target={ lessonTarget }
				hx-swap="outerHTML"
				class="flex flex-1 flex-wrap items-start gap-2"
			>
				@markFields(mark.Fields)
				<span class="ml-auto flex flex-wrap items-center gap-2">
					<button type="submit" class={ components.ButtonPrimaryClass }>Сохранить</button>
					<a href={ templ.SafeURL(mark.CancelHref) } hx-get={ mark.CancelHref } hx-target={ lessonTarget } hx-swap="outerHTML" class={ components.ButtonSecondaryClass }>Отмена</a>
				</span>
			</form>
		} else {
			<span class="flex min-w-0 basis-full flex-wrap items-center gap-x-3 gap-y-1 sm:flex-1 sm:basis-auto">
				<span class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-base font-semibold text-indigo-700">{ mark.Value }</span>
				<span class="text-sm font-medium text-slate-900">{ mark.WorkType }</span>
				if mark.Label != "" {
					<span class="text-sm text-slate-600">{ mark.Label }</span>
				}
			</span>
			<span class="ml-auto flex flex-wrap items-center gap-2">
				@components.EditLink(mark.EditHref, lessonTarget)
				<form
					method="post"
					action={ templ.SafeURL(mark.DeleteAction) }
					hx-post={ mark.DeleteAction }
					hx-target={ lessonTarget }
					hx-swap="outerHTML"
					hx-confirm={ "Удалить оценку " + mark.Value + " (" + mark.WorkType + ")?" }
					data-confirm-ok="Удалить"
				>
					<button type="submit" class={ components.ButtonDangerClass }>Удалить</button>
				</form>
			</span>
		}
	</li>
}

templ recordForms(record view.RecordFields) {
	<div class="group flex flex-col gap-3 border-t border-slate-100 p-3 sm:p-4">
		<form
			method="post"
			action={ templ.SafeURL(record.Action) }
			hx-post={ record.Action }
			hx-target={ lessonTarget }
			hx-swap="outerHTML"
			class="flex"
		>
			<input type="hidden" name="comment" value={ record.Comment }/>
			if record.Absent {
				<input type="hidden" name="absent" value="0"/>
				<button type="submit" class={ components.ButtonActiveClass } aria-pressed="true">
					@components.Icon(view.IconCheck, "size-4")
					<span>Отсутствовал</span>
				</button>
			} else {
				<input type="hidden" name="absent" value="1"/>
				<button type="submit" class={ components.ButtonSecondaryClass } aria-pressed="false">Отсутствовал</button>
			}
		</form>
		if record.Comment != "" {
			<p class="rounded-lg bg-slate-50 px-3 py-2.5 text-sm text-slate-700 group-has-[[open]]:hidden">{ record.Comment }</p>
		}
		<details open?={ record.Error != "" }>
			<summary class={ components.ButtonSecondaryClass, "w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden" }>
				if record.Comment != "" {
					Изменить комментарий
				} else {
					Добавить комментарий
				}
			</summary>
			<form
				method="post"
				action={ templ.SafeURL(record.Action) }
				hx-post={ record.Action }
				hx-target={ lessonTarget }
				hx-swap="outerHTML"
				class="mt-3 flex flex-col gap-3"
			>
				if record.Absent {
					<input type="hidden" name="absent" value="1"/>
				} else {
					<input type="hidden" name="absent" value="0"/>
				}
				<span class="flex min-w-0 flex-col gap-1">
					<textarea
						name="comment"
						rows="3"
						placeholder="Комментарий ученику"
						aria-label="Комментарий ученику"
						maxlength="500"
						autofocus
						class={ components.InputClassFor(record.Error), "py-2" }
					>{ record.Comment }</textarea>
					@components.FieldError(record.Error)
				</span>
				<button type="submit" class={ components.ButtonPrimaryClass, "self-start" }>Сохранить</button>
			</form>
		</details>
	</div>
}
