package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Backup(page view.BackupPage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-4 lg:gap-6">
			@components.PageHeader("Резервная копия")
			@components.PageHint(hintBackup)
			@components.PageHelp("Как восстановить данные из архива") {
				<ol class="list-decimal space-y-2 pl-5">
					<li>Остановите сервер</li>
					<li>Распакуйте архив: файл <code class="font-mono">school.db</code> положите по пути <code class="font-mono">db.path</code> из конфига, содержимое каталога <code class="font-mono">files</code> — в <code class="font-mono">files.dir</code></li>
					<li>Запустите сервер той же или более новой версии приложения</li>
				</ol>
				<p>Подробная инструкция с командами — в файле README из архива установки</p>
			}
			<div class={ components.CardClass, "flex flex-wrap items-center gap-3 p-4 sm:p-5" }>
				<p class="min-w-0 flex-1 basis-56 text-sm text-slate-700">Файлы домашних заданий: { page.Files }</p>
				<a href={ templ.SafeURL(page.DownloadPath) } class={ components.ButtonPrimaryClass }>Скачать архив</a>
			</div>
		</div>
	}
}
