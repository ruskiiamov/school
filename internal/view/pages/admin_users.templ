package pages

import (
	"strconv"

	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const usersTarget = "#users"

templ Users(page view.UsersPage) {
	@layout.App(page.Shell) {
		@UsersPage(page)
	}
}

templ UsersPage(page view.UsersPage) {
	<div id="users" class="flex flex-col gap-4 lg:gap-6">
		@components.PageHeader(page.Title) {
			@components.InactiveToggle(page.ToggleHref, page.ShowInactive)
		}
		<form
			method="get"
			action={ templ.SafeURL(page.Path) }
			hx-get={ page.Path }
			hx-target={ usersTarget }
			hx-swap="outerHTML"
			hx-trigger="submit, input changed delay:300ms, change"
			hx-push-url="true"
			class={ components.CardClass, "flex flex-wrap items-center gap-2 p-3 sm:p-4" }
		>
			<input
				type="search"
				id="users-search"
				hx-preserve
				name="q"
				value={ page.Query }
				placeholder="Поиск по ФИО"
				aria-label="Поиск по ФИО"
				autocomplete="off"
				class={ components.InputClass, "flex-1 basis-56" }
			/>
			if len(page.ClassFilter) > 0 {
				@components.RowSelect("class", "Класс", page.ClassFilter, "", "basis-36 shrink-0")
			}
			if page.ShowInactive {
				<input type="hidden" name="inactive" value="1"/>
			}
			<button type="submit" class={ components.ButtonSecondaryClass }>Найти</button>
		</form>
		<form
			method="post"
			action={ templ.SafeURL(page.Path + page.ListQuery) }
			hx-post={ page.Path + page.ListQuery }
			hx-target={ usersTarget }
			hx-swap="outerHTML"
			class={ components.CardClass, "flex flex-wrap items-start gap-2 p-3 sm:p-4" }
		>
			@userFields(page.New, true)
			<button type="submit" class={ components.ButtonPrimaryClass, "shrink-0" }>
				@components.Icon(view.IconPlus, "size-4")
				<span>Добавить</span>
			</button>
		</form>
		<div class={ components.CardClass }>
			if len(page.Users) == 0 {
				@components.EmptyState(page.EmptyMessage)
			} else {
				<ul class="divide-y divide-slate-100">
					for _, user := range page.Users {
						@userRow(page, user)
					}
				</ul>
			}
		</div>
	</div>
}

templ userFields(fields view.UserFields, isNew bool) {
	if isNew {
		@components.RowInput("full_name", fields.FullName, "ФИО нового пользователя", "ФИО", fields.Errors["full_name"], "flex-1 basis-56")
	} else {
		@components.RowInput("full_name", fields.FullName, "ФИО", "ФИО", fields.Errors["full_name"], "flex-1 basis-52")
	}
	if len(fields.Classes) > 0 {
		@components.RowSelect("class", "Класс", fields.Classes, fields.Errors["class"], "basis-36 shrink-0")
	}
	if !isNew {
		@components.RowInput("login", fields.Login, "Логин", "Логин", fields.Errors["login"], "flex-1 basis-44")
	}
}

templ userRow(page view.UsersPage, row view.UserRow) {
	<li class="flex flex-wrap items-center gap-2 p-3 sm:p-4">
		if row.Editing {
			<form
				method="post"
				action={ templ.SafeURL(userURL(page.Path, row.ID, "", page.ListQuery)) }
				hx-post={ userURL(page.Path, row.ID, "", page.ListQuery) }
				hx-target={ usersTarget }
				hx-swap="outerHTML"
				class="flex flex-1 flex-wrap items-start gap-2"
			>
				@userFields(row.Fields, false)
				<span class="ml-auto flex flex-wrap items-center gap-2">
					<button type="submit" class={ components.ButtonPrimaryClass }>Сохранить</button>
					<a href={ templ.SafeURL(page.Path + page.ListQuery) } hx-get={ page.Path + page.ListQuery } hx-target={ usersTarget } hx-swap="outerHTML" class={ components.ButtonSecondaryClass }>Отмена</a>
				</span>
			</form>
			if row.Children != nil {
				@childrenBlock(*row.Children)
			}
		} else {
			<span class="flex min-w-0 basis-full items-center gap-2 sm:flex-1 sm:basis-auto">
				if row.Active {
					<span class="truncate text-sm font-medium text-slate-900">{ row.FullName }</span>
				} else {
					<span class="truncate text-sm text-slate-500">{ row.FullName }</span>
					@components.InactiveBadge()
				}
			</span>
			if page.ShowClass {
				<span class="text-sm text-slate-600 sm:w-20">
					if row.ClassName != "" {
						{ row.ClassName }
					} else {
						<span class="text-slate-400">без класса</span>
					}
				</span>
			}
			if page.ShowChildren {
				<span class="min-w-0 basis-full truncate text-sm text-slate-600 sm:flex-1 sm:basis-auto">
					if row.ChildNames != "" {
						{ row.ChildNames }
					} else {
						<span class="text-slate-400">нет детей</span>
					}
				</span>
			}
			<span class="font-mono text-sm text-slate-600 sm:w-44 sm:truncate">{ row.Login }</span>
			<span class="ml-auto flex flex-wrap items-center gap-2">
				@components.EditLink(userEditURL(page.Path, page.ListQuery, row.ID), usersTarget)
				@components.ActiveForm(row.Active,
					userURL(page.Path, row.ID, "/deactivate", page.ListQuery),
					userURL(page.Path, row.ID, "/activate", page.ListQuery), usersTarget)
			</span>
		}
	</li>
}

templ childrenBlock(block view.ChildrenBlock) {
	<div class="flex basis-full flex-col gap-3 border-t border-slate-100 pt-3">
		<h3 class="text-sm font-semibold text-slate-900">Дети</h3>
		if len(block.Children) == 0 {
			<p class="text-sm text-slate-500">Пока нет детей</p>
		} else {
			<ul class="flex flex-col gap-2">
				for _, child := range block.Children {
					<li class="flex flex-wrap items-center gap-2">
						@memberName(child)
						@removeForm(child.RemoveAction, usersTarget)
					</li>
				}
			</ul>
		}
		<form
			method="get"
			action={ templ.SafeURL(block.SearchAction) }
			hx-get={ block.SearchAction }
			hx-target={ usersTarget }
			hx-swap="outerHTML"
			hx-trigger="submit, input changed delay:300ms, change"
			hx-push-url="true"
			class="flex flex-wrap items-center gap-2"
		>
			for name, value := range block.Hidden {
				<input type="hidden" name={ name } value={ value }/>
			}
			<input
				type="search"
				id="child-search"
				hx-preserve
				name="child"
				value={ block.Query }
				placeholder="Найти ученика по ФИО"
				aria-label="Найти ученика по ФИО"
				autocomplete="off"
				class={ components.InputClass, "flex-1 basis-56" }
			/>
			<button type="submit" class={ components.ButtonSecondaryClass }>Найти</button>
		</form>
		if block.Searched {
			if len(block.Results) == 0 {
				<p class="text-sm text-slate-500">Ничего не найдено</p>
			} else {
				<ul class="flex flex-col gap-2">
					for _, student := range block.Results {
						<li class="flex flex-wrap items-center gap-2">
							@memberName(student)
							<form method="post" action={ templ.SafeURL(block.AddAction) } hx-post={ block.AddAction } hx-target={ usersTarget } hx-swap="outerHTML" class="ml-auto">
								<input type="hidden" name="student_id" value={ strconv.FormatInt(student.ID, 10) }/>
								<button type="submit" class={ components.ButtonSecondaryClass }>Добавить</button>
							</form>
						</li>
					}
				</ul>
			}
		}
		@components.FieldError(block.Error)
	</div>
}
