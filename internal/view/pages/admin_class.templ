package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Class(page view.ClassPage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-4 lg:gap-6">
			@components.PageHeader(page.Name + " · " + page.YearName) {
				if !page.Active {
					@components.InactiveBadge()
				}
			}
			<div class="grid gap-4 lg:grid-cols-2 lg:gap-6">
				@classPanel("Ученики") {
					@components.EmptyState("Пока нет учеников")
				}
				@classPanel("Предметы и учителя") {
					@components.EmptyState("Предметы пока не назначены")
				}
			</div>
		</div>
	}
}

templ classPanel(title string) {
	<section class={ components.CardClass }>
		<div class="border-b border-slate-100 px-4 py-3 lg:px-5">
			<h2 class="text-sm font-semibold text-slate-900">{ title }</h2>
		</div>
		{ children... }
	</section>
}
