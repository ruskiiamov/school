package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

const passwordResetTarget = "#password-reset"

templ PasswordReset(page view.PasswordResetPage) {
	@layout.App(page.Shell) {
		@PasswordResetPage(page)
	}
}

templ PasswordResetPage(page view.PasswordResetPage) {
	<div id="password-reset" class="flex flex-col gap-4 lg:gap-6">
		@components.PageHeader("Сброс пароля")
		@components.PageHint(hintReset)
		<form
			method="get"
			action={ templ.SafeURL(page.Path) }
			hx-get={ page.Path }
			hx-target={ passwordResetTarget }
			hx-swap="outerHTML"
			hx-trigger="submit, input changed delay:300ms, change"
			hx-push-url="true"
			class={ components.CardClass, "flex flex-wrap items-center gap-2 p-3 sm:p-4" }
		>
			<input
				type="search"
				id="password-reset-search"
				hx-preserve
				name="q"
				value={ page.Query }
				placeholder="Поиск по ФИО"
				aria-label="Поиск по ФИО"
				autocomplete="off"
				class={ components.InputClass, "flex-1 basis-56" }
			/>
		</form>
		<div class={ components.CardClass }>
			if page.Query == "" {
				@components.EmptyState("Введите ФИО, чтобы найти пользователя")
			} else if len(page.Users) == 0 {
				@components.EmptyState("Ничего не найдено")
			} else {
				<ul class="divide-y divide-slate-100">
					for _, user := range page.Users {
						@passwordResetRow(user)
					}
				</ul>
			}
		</div>
	</div>
}

templ passwordResetRow(row view.PasswordResetRow) {
	<li class="flex flex-wrap items-center gap-2 p-3 sm:p-4">
		<span class="flex min-w-0 basis-full items-center gap-2 sm:flex-1 sm:basis-auto">
			<span class="truncate text-sm font-medium text-slate-900">{ row.FullName }</span>
		</span>
		<span class="text-sm text-slate-600 sm:w-20">{ row.Role }</span>
		<span class="text-sm text-slate-600 sm:w-20">{ row.ClassName }</span>
		<span class="font-mono text-sm text-slate-600 sm:w-44 sm:truncate">{ row.Login }</span>
		<form
			method="post"
			action={ templ.SafeURL(row.Action) }
			hx-post={ row.Action }
			hx-confirm={ "Сбросить пароль пользователю " + row.FullName + "?" }
			data-confirm-ok="Сбросить"
			class="ml-auto"
		>
			<button type="submit" class={ components.ButtonSecondaryClass }>Сбросить пароль</button>
		</form>
	</li>
}
