package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ UserCreated(page view.UserCreatedPage) {
	@layout.App(page.Shell) {
		<div class="mx-auto flex w-full max-w-xl flex-col gap-4 lg:gap-6">
			@components.PageHeader(page.Title)
			<div class={ components.CardClass, "flex flex-col gap-4 p-4 sm:p-6" }>
				<p class="text-base font-medium text-slate-900">{ page.FullName }</p>
				<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 text-sm">
					<dt class="text-slate-500">Логин</dt>
					<dd class="font-mono text-slate-900">{ page.Login }</dd>
					<dt class="text-slate-500">Пароль</dt>
					<dd class="font-mono text-slate-900">{ page.Password }</dd>
				</dl>
				<p class="text-sm text-slate-500">{ page.Note }</p>
				<div class="flex flex-wrap justify-end gap-2 pt-2">
					<a href={ templ.SafeURL(page.ListHref) } class={ components.ButtonSecondaryClass }>К списку</a>
					if page.NewHref != "" {
						<a href={ templ.SafeURL(page.NewHref) } class={ components.ButtonPrimaryClass }>{ page.NewTitle }</a>
					}
				</div>
			</div>
		</div>
	}
}
