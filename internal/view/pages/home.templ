package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Home(page view.HomePage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-6 lg:gap-8">
			<div>
				<h1 class="text-xl font-semibold text-slate-900 sm:text-2xl">
					Здравствуйте, { page.Shell.User.FullName }
				</h1>
				<p class="mt-1 text-sm text-slate-500">Сегодня { page.Today }</p>
			</div>
			if page.NoClasses {
				<div class="flex flex-wrap items-center gap-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-900 ring-1 ring-amber-200">
					@components.Icon(view.IconAlert, "size-5 shrink-0 text-amber-600")
					<span class="flex-1">В { page.YearName } ещё нет классов</span>
					<a href="/admin/classes" class={ components.ButtonPrimaryClass }>Создать класс</a>
				</div>
			}
			if len(page.Stats) > 0 {
				<section class="flex flex-col gap-3">
					<h2 class="text-sm font-semibold text-slate-900">Учебный год { page.YearName }</h2>
					<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
						for _, stat := range page.Stats {
							@components.StatCard(stat)
						}
					</div>
				</section>
			}
			if page.Section.Href != "" {
				<a
					href={ templ.SafeURL(page.Section.Href) }
					class={ components.CardClass, "flex items-center gap-4 p-4 hover:ring-indigo-300 active:bg-slate-50 sm:p-5" }
				>
					<span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700">
						@components.Icon(page.Section.Icon, "size-6")
					</span>
					<span class="flex min-w-0 flex-col">
						<span class="text-base font-semibold text-slate-900">{ page.Section.Title }</span>
						<span class="text-sm text-slate-500">Раздел в разработке и появится в одной из следующих итераций</span>
					</span>
				</a>
			}
		</div>
	}
}
