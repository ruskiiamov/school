package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Home(page view.HomePage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-6 lg:gap-8">
			<div>
				<h1 class="text-xl font-semibold text-slate-900 sm:text-2xl">
					Здравствуйте, { page.Shell.User.Greeting }
				</h1>
				<p class="mt-1 text-sm text-slate-500">Сегодня { page.Today }</p>
			</div>
			if len(page.Setup) > 0 {
				@setupCard(page.Setup)
			}
			if len(page.Stats) > 0 {
				<section class="flex flex-col gap-3">
					<h2 class="text-sm font-semibold text-slate-900">Учебный год { page.YearName }</h2>
					<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
						for _, stat := range page.Stats {
							@components.StatCard(stat)
						}
					</div>
				</section>
			}
			if page.Teacher != nil {
				@TeacherHome(*page.Teacher)
			}
			if page.NoChildren {
				<div class={ components.CardClass }>
					@components.EmptyState("К вашему аккаунту не привязаны дети")
				</div>
			}
			if len(page.Children) > 1 {
				<nav aria-label="Дети" class="flex flex-wrap gap-2">
					for _, child := range page.Children {
						@childTab(child)
					}
				</nav>
			}
			if page.Student != nil {
				@studentDashboard(*page.Student)
			}
		</div>
	}
}

templ setupCard(steps []view.SetupStep) {
	<section class={ components.CardClass, "flex flex-col gap-1 p-4 sm:p-5" }>
		<h2 class="text-base font-semibold text-slate-900">Начало работы</h2>
		<p class="text-sm text-slate-500">Пройдите шаги по порядку. Когда обязательные будут выполнены, этот блок исчезнет</p>
		<ol class="mt-2 divide-y divide-slate-100">
			for _, step := range steps {
				<li>
					<a href={ templ.SafeURL(step.Href) } class="flex items-start gap-3 rounded-lg py-3 hover:bg-slate-50 active:bg-slate-100">
						if step.Done {
							<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
								@components.Icon(view.IconCheck, "size-4")
								<span class="sr-only">Готово</span>
							</span>
						} else {
							<span class="size-6 shrink-0 rounded-full ring-2 ring-inset ring-slate-300">
								<span class="sr-only">Не сделано</span>
							</span>
						}
						<span class="flex min-w-0 flex-col">
							<span class="text-sm font-medium text-slate-900">{ step.Title }</span>
							<span class="text-sm text-slate-500">{ step.Note }</span>
						</span>
					</a>
				</li>
			}
		</ol>
	</section>
}

templ dashboardCardHeader(title, href, label string) {
	<div class="flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 lg:px-5">
		<h2 class="min-w-0 truncate text-sm font-semibold text-slate-900">{ title }</h2>
		<a href={ templ.SafeURL(href) } class="shrink-0 text-sm font-medium text-indigo-700 hover:underline">{ label }</a>
	</div>
}

templ TeacherHome(home view.TeacherHome) {
	<div id="teacher-home" class="flex flex-col gap-4 lg:gap-6">
		<form
			method="get"
			action={ templ.SafeURL(home.Path) }
			hx-get={ home.Path }
			hx-target="#teacher-home"
			hx-swap="outerHTML"
			hx-trigger="submit, change"
			hx-push-url="true"
			class="flex flex-wrap items-start gap-2"
		>
			@components.RowSelect("year", "Учебный год", home.Years, "", "basis-36")
			@components.NoScriptSubmit("Показать")
		</form>
		if len(home.Assigned) == 0 && len(home.Substitutions) == 0 {
			<div class={ components.CardClass }>
				@components.EmptyState("В этом году вам не назначены классы и предметы")
			</div>
		}
		if len(home.Assigned) > 0 {
			@pairCards("Мои классы", home.Assigned)
		}
		if len(home.Substitutions) > 0 {
			@pairCards("Замены", home.Substitutions)
		}
	</div>
}

templ pairCards(title string, cards []view.PairCard) {
	<section class="flex flex-col gap-3">
		<h2 class="text-sm font-semibold text-slate-900">{ title }</h2>
		<ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
			for _, card := range cards {
				<li>
					<a href={ templ.SafeURL(card.Href) } class={ components.CardClass, "flex h-full flex-col gap-1 p-4 hover:bg-slate-50 active:bg-slate-100" }>
						<span class="text-base font-semibold text-slate-900">{ card.Name }</span>
						for _, period := range card.Periods {
							<span class="text-sm text-slate-700">{ period }</span>
						}
						if card.OwnOnly {
							<span class="text-sm text-slate-700">только ваши уроки</span>
						}
						<span class="text-sm text-slate-500">{ card.Lessons }</span>
					</a>
				</li>
			}
		</ul>
	</section>
}

templ studentDashboard(board view.StudentDashboard) {
	<div class="flex flex-col gap-4 lg:gap-6">
		if board.Penalty != nil {
			<section class={ components.CardClass }>
				@dashboardCardHeader(board.Penalty.Title, board.Penalty.Href, "Подробнее")
				<p class="px-4 py-3 text-sm font-semibold text-amber-700 lg:px-5">{ board.Penalty.Debt }</p>
			</section>
		}
		<section class={ components.CardClass }>
			@dashboardCardHeader("Сегодня", board.DiaryHref, "Дневник")
			if len(board.Lessons) == 0 {
				@components.EmptyState("Уроков сегодня пока нет")
			} else {
				<ul class="divide-y divide-slate-100">
					for _, lesson := range board.Lessons {
						<li>
							<a href={ templ.SafeURL(lesson.Href) } class="flex min-h-11 items-center gap-3 p-3 hover:bg-slate-50 sm:px-4">
								<span class="flex min-w-0 flex-1 flex-col">
									<span class="truncate text-sm font-medium text-slate-900">{ lesson.Subject }</span>
									<span class="truncate text-xs text-slate-500">{ lesson.Teacher }</span>
								</span>
								if lesson.Summary != "" {
									<span class="shrink-0 text-sm font-semibold text-slate-700">{ lesson.Summary }</span>
								}
								if lesson.Homework {
									<span class="shrink-0 rounded-md bg-indigo-50 px-1.5 py-0.5 text-xs font-medium text-indigo-700">ДЗ</span>
								}
							</a>
						</li>
					}
				</ul>
			}
		</section>
		<section class={ components.CardClass }>
			@dashboardCardHeader("Оценки за неделю", board.MarksHref, "Все оценки")
			if len(board.Subjects) == 0 {
				@components.EmptyState("За последние семь дней оценок нет")
			} else {
				<ul class="divide-y divide-slate-100">
					for _, subject := range board.Subjects {
						@subjectMarksRow(subject)
					}
				</ul>
			}
		</section>
	</div>
}

templ childTab(child view.DiaryChild) {
	<a
		href={ templ.SafeURL(child.Href) }
		if child.Active {
			aria-current="page"
			class={ components.TabActiveClass }
		} else {
			class={ components.TabClass }
		}
	>{ child.Name }</a>
}
