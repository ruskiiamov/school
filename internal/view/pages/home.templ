package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Home(page view.HomePage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-6 lg:gap-8">
			<div>
				<h1 class="text-xl font-semibold text-slate-900 sm:text-2xl">
					Здравствуйте, { page.Shell.User.FullName }
				</h1>
				<p class="mt-1 text-sm text-slate-500">Сегодня { page.Today }</p>
			</div>
			if len(page.Setup) > 0 {
				@setupCard(page.Setup)
			}
			if len(page.Stats) > 0 {
				<section class="flex flex-col gap-3">
					<h2 class="text-sm font-semibold text-slate-900">Учебный год { page.YearName }</h2>
					<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
						for _, stat := range page.Stats {
							@components.StatCard(stat)
						}
					</div>
				</section>
			}
			if page.Section.Href != "" {
				<a
					href={ templ.SafeURL(page.Section.Href) }
					class={ components.CardClass, "flex items-center gap-4 p-4 hover:ring-indigo-300 active:bg-slate-50 sm:p-5" }
				>
					<span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700">
						@components.Icon(page.Section.Icon, "size-6")
					</span>
					<span class="flex min-w-0 flex-col">
						<span class="text-base font-semibold text-slate-900">{ page.Section.Title }</span>
						<span class="text-sm text-slate-500">{ page.SectionNote }</span>
					</span>
				</a>
			}
		</div>
	}
}

templ setupCard(steps []view.SetupStep) {
	<section class={ components.CardClass, "flex flex-col gap-1 p-4 sm:p-5" }>
		<h2 class="text-base font-semibold text-slate-900">Начало работы</h2>
		<p class="text-sm text-slate-500">Пройдите шаги по порядку. Когда обязательные будут выполнены, этот блок исчезнет.</p>
		<ol class="mt-2 divide-y divide-slate-100">
			for _, step := range steps {
				<li>
					<a href={ templ.SafeURL(step.Href) } class="flex items-start gap-3 rounded-lg py-3 hover:bg-slate-50 active:bg-slate-100">
						if step.Done {
							<span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700">
								@components.Icon(view.IconCheck, "size-4")
								<span class="sr-only">Готово</span>
							</span>
						} else {
							<span class="size-6 shrink-0 rounded-full ring-2 ring-inset ring-slate-300">
								<span class="sr-only">Не сделано</span>
							</span>
						}
						<span class="flex min-w-0 flex-col">
							<span class="text-sm font-medium text-slate-900">{ step.Title }</span>
							<span class="text-sm text-slate-500">{ step.Note }</span>
						</span>
					</a>
				</li>
			}
		</ol>
	</section>
}
