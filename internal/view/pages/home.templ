package pages

import (
	"github.com/ruskiiamov/school/internal/view"
	"github.com/ruskiiamov/school/internal/view/components"
	"github.com/ruskiiamov/school/internal/view/layout"
)

templ Home(page view.HomePage) {
	@layout.App(page.Shell) {
		<div class="flex flex-col gap-6 lg:gap-8">
			<div>
				<h1 class="text-xl font-semibold text-slate-900 sm:text-2xl">
					Здравствуйте, { page.Shell.User.FullName }
				</h1>
				<p class="mt-1 text-sm text-slate-500">Сегодня { page.Today }</p>
			</div>
			<div class="grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-6">
				for _, stat := range page.Stats {
					@components.StatCard(stat)
				}
			</div>
			<div class="grid gap-4 lg:gap-6 xl:grid-cols-3">
				@panel("Ближайшие уроки", view.IconClock, "xl:col-span-2") {
					@emptyState("Расписание появится, когда будут заведены классы и предметы.")
				}
				@panel("Объявления", view.IconMegaphone, "") {
					@emptyState("Пока нет объявлений.")
				}
			</div>
		</div>
	}
}

templ panel(title string, icon view.Icon, class string) {
	<section class={ "rounded-xl bg-white shadow-sm ring-1 ring-slate-200", class }>
		<div class="flex items-center gap-2 border-b border-slate-100 px-4 py-3 lg:px-5">
			@components.Icon(icon, "size-4 shrink-0 text-slate-400")
			<h2 class="text-sm font-semibold text-slate-900">{ title }</h2>
		</div>
		<div class="px-4 py-6 lg:px-5">
			{ children... }
		</div>
	</section>
}

templ emptyState(message string) {
	<p class="text-center text-sm text-slate-500">{ message }</p>
}
